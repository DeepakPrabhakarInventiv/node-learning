{{> header }}

<div class="bg-white">
    <div class="container py-5">

        <h3 class="border-bottom border-dark pb-2 mb-5">Cart</h3>

        <!-- Begin::Products -->
        <div class="row">
            <div class="col-md-9">
                <div id="products" class="cart-items">
                    Loading...
                </div>
            </div>
            <div class="col-md-3" id="sidebar">
                <div class="border p-3 rounded">
                    <h3 class="border-bottom border-dark pb-1 mb-3">Cart Summary</h3>
                    <div id="order-info"></div>
                    <a href="/checkout" class="btn btn-primary w-100">Checkout</a>
                </div>
            </div>
        </div>
        <!-- End::Products -->

    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>


<script src="https://unpkg.com/axios@1.6.7/dist/axios.min.js"></script>
<script>
    window.addEventListener('load', function () {
        // Send form data to the server using axios
        const url = `/cart/products`;
        axios.post(url)
            .then(function (response) {
                console.log(response);
                document.getElementById('products').innerHTML = generateCart(response.data);

                //update sidebar
                updateSidebar();

            })
            .catch(function (error) {
                document.getElementById('products').innerHTML = error.response.data.message;
                console.error(error);
            });
    });

    function generateCart(products) {
        let outputHtml = ``;
        products.forEach(function (productItem, index) {
            const product = productItem.product_id;
            outputHtml += `<div class="cart-item card mb-3" id="${productItem._id}">
                                <div class="card-body">
                                    <h5 class="product-name">${product.name}</h5> 
                                    <p>Category: ${product.category}</p>
                                    <p>Price: <span class="price-value">${product.price}</span></p>
                                </div>
                                <div class="card-footer">
                                    <form method="POST" class="form">
                                        <div class="row">
                                            <div class="col">
                                                <div class="update-cart d-flex">
                                                    <input type="number" id="cq-${productItem._id}" name="quantity" value="${productItem.count}" class="form-control" style="max-width:60px"/>
                                                    <button type="button" name="update-cart-btn" class="update-cart-btn btn btn-outline-primary ms-2" data-cid="${productItem._id}" data-pid="${product._id}">Update</button>
                                                </div>
                                            </div>
                                            <div class="col text-end">
                                                <button type="button" class="remove-from-cart btn btn-outline-danger" data-cid="${productItem._id}">Remove</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>`;
        });


        return outputHtml;

    }

    function updateSidebar() {

        // Get the container and sidebar
        const cartItemsContainer = document.querySelector(".cart-items");
        const cartItems = cartItemsContainer.querySelectorAll(".cart-item");
        const totalItems = cartItems.length;
        let total = parseFloat(0);

        var outputHtml = '<div class="">';
        cartItems.forEach((item, index) => {
            const productName = item.querySelector(".product-name")?.textContent || `Product ${index + 1}`;
            const quantity = parseInt(item.querySelector("input[name='quantity']").value);
            const price = parseFloat(item.querySelector(".price-value")?.textContent);
            const subtotal = price * quantity;
            total += subtotal;


            outputHtml += `<div class="border-bottom mb-3 mt-0 pb-3">
                                    <h5>${productName}</h5> 
                                    <p class="m-0">Quantity: ${quantity}</p>
                                    <p class="m-0">Price: ${price}</p>
                                    <p class="m-0">Sub Total: ${subtotal}</p>
                                </div>`;
        });

        outputHtml += `<div class="border-bottom mb-3 mt-0 pb-3">
                                    <h5>Total : ${total}</h5> 
                                </div>`;

        document.getElementById('order-info').innerHTML = outputHtml;


    }

    //update thr cart
    const container = document.getElementById('products');
    container.addEventListener('click', (event) => {
        if (event.target.classList.contains('update-cart-btn')) {
            const cid = event.target.getAttribute('data-cid');
            const pid = event.target.getAttribute('data-pid');
            const quantity = document.getElementById(`cq-${cid}`).value;
            //send it to API
            const formData = {
                'count': quantity,
                'product_id': pid,
            };

            const url = `/cart/${cid}`;
            axios.patch(url, formData)
                .then(function (response) {
                    console.log(response);
                    createToast('Success', response.data.message, 'success');

                    //update sidebar
                    updateSidebar();
                })
                .catch(function (error) {
                    console.error(error);
                    createToast('Error', error.response.data.message, 'danger');
                });
        }
    });

    //remove from the cart
    container.addEventListener('click', (event) => {
        if (event.target.classList.contains('remove-from-cart')) {
            const cid = event.target.getAttribute('data-cid');
            //send it to API
            const formData = {
                'id': cid
            };
            const url = `/cart/delete`;
            axios.post(url, formData)
                .then(function (response) {
                    console.log(response);
                    createToast('Success', response.data.message, 'success');
                    document.getElementById(cid).remove();

                    //update sidebar
                    updateSidebar();
                })
                .catch(function (error) {
                    console.error(error);
                    createToast('Error', error.response.data.message, 'danger');
                });
        }
    });


    // Function to create and show a Bootstrap toast
    function createToast(title, message, type) {
        // Generate a unique ID for the toast
        const toastId = `toast-${Date.now()}`;

        // Toast template
        const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
          <div class="d-flex" data-bs-theme="dark">
            <div class="toast-body" >
              <strong>${title}:</strong> ${message}
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      `;

        // Create a wrapper element and set its inner HTML
        const wrapper = document.createElement('div');
        wrapper.innerHTML = toastHtml.trim();

        // Append the toast to the container
        const toastContainer = document.getElementById('toast-container');
        toastContainer.appendChild(wrapper.firstChild);

        // Initialize and show the toast
        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement, { delay: 5000 }); // 5-second delay
        toast.show();

        // Remove the toast from the DOM after it hides
        toastElement.addEventListener('hidden.bs.toast', function () {
            toastElement.remove();
        });
    }
</script>

{{> footer }}