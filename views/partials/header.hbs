<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <header class="border-bottom">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3">
                <div class="col-md-4 mb-2 mb-md-0">

                    <a href="/" class="d-inline-flex link-body-emphasis text-decoration-none">
                        <strong class="text-uppercase d-flex align-items-center" style="line-height:18px">
                            <i class="bi bi-bag-check-fill" style="font-size:35px"></i>
                            <span class="ms-2"><big>Ecommerce </big><br><small>Node Js</small></span>
                        </strong>
                    </a>


                </div>

                <div class="col-md-8 text-end d-flex justify-content-end align-items-center">

                    <div class="d-flex align-items-center">
                        {{#if isLoggedIn}}
                        <ul class="nav col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                            <li><a href="/" class="nav-link px-2 link-body-emphasis">Home</a></li>
                            <li><a href="/product" class="nav-link px-2 link-body-emphasis">Products</a></li>
                        </ul>


                        {{/if}}

                        <div class="side-menu">
                            {{#if isLoggedIn}}

                            <div class="dropdown text-end d-flex align-items-center">
                                <a href="/cart" class="nav-link px-2 link-body-emphasis d-flex align-items-center">
                                    <i class="bi bi-bag me-1"></i>
                                    <span class="badge rounded-1 bg-success text-white">{{
                                        cartCount }}</span>
                                </a>

                                <span class="mx-1">|</span>

                                <a href="/wishlist" class="nav-link px-2 link-body-emphasis d-flex align-items-center">
                                    <i class="bi bi-heart me-1"></i>
                                    <span class="badge rounded-1 bg-danger text-white">{{
                                        wishlistCount }}</span>
                                </a>

                                <span class="mx-1 me-3">|</span>

                                <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://github.com/mdo.png" alt="mdo" width="32" height="32"
                                        class="rounded-circle">
                                </a>
                                <ul class="dropdown-menu text-small" style="">
                                    <li><a href="/profile" class="dropdown-item" href="#">Profile</a></li>
                                    <li><a href="/wishlist" class="dropdown-item d-flex align-items-center">Wishlist</a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a href="/logout" class="dropdown-item" href="#">Logout</a></li>
                                </ul>
                            </div>
                            {{else }}

                            <a href="/login" class="btn btn-outline-primary me-2">Login</a>
                            <a href="/registration" class="btn btn-primary me-2">Sign-up</a>
                            {{/if }}
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </header>