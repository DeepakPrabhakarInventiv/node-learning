<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body>

    <header class="border-bottom">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3">
                <div class="col-md-4 mb-2 mb-md-0">

                    <a href="/" class="d-inline-flex link-body-emphasis text-decoration-none">
                        <strong class="text-uppercase d-flex align-items-center" style="line-height:18px">
                            <svg xmlns="http://www.w3.org/2000/svg" width="50" class="border border-primary p-2 rounded"
                                viewBox="0 0 576 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
                                <path
                                    d="M253.3 35.1c6.1-11.8 1.5-26.3-10.2-32.4s-26.3-1.5-32.4 10.2L117.6 192 32 192c-17.7 0-32 14.3-32 32s14.3 32 32 32L83.9 463.5C91 492 116.6 512 146 512L430 512c29.4 0 55-20 62.1-48.5L544 256c17.7 0 32-14.3 32-32s-14.3-32-32-32l-85.6 0L365.3 12.9C359.2 1.2 344.7-3.4 332.9 2.7s-16.3 20.6-10.2 32.4L404.3 192l-232.6 0L253.3 35.1zM192 304l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16s16 7.2 16 16zm96-16c8.8 0 16 7.2 16 16l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16zm128 16l0 96c0 8.8-7.2 16-16 16s-16-7.2-16-16l0-96c0-8.8 7.2-16 16-16s16 7.2 16 16z" />
                            </svg>
                            <span class="ms-2"><big>Ecommerce </big><br><small>Node Js</small></span>
                        </strong>
                    </a>


                </div>




                <div class="col-md-8 text-end d-flex justify-content-end align-items-center">

                    <div class="d-flex align-items-center">
                        {{#if isLoggedIn}}
                        <ul class="nav col-lg-auto me-lg-auto mb-2 justify-content-center mb-md-0">
                            <li><a href="/" class="nav-link px-2 link-body-emphasis">Home</a></li>
                            <li><a href="/product" class="nav-link px-2 link-body-emphasis">Products</a></li>
                        </ul>


                        {{/if}}

                        <div class="side-menu">
                            {{#if isLoggedIn}}

                            <div class="dropdown text-end d-flex align-items-center">
                                <a href="/cart" class="nav-link px-2 link-body-emphasis">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="20">
                                        <path
                                            d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z" />
                                    </svg></a>

                                <span class="mx-1">|</span>

                                <a href="/wishlist" class="nav-link px-2 link-body-emphasis">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="20" fill="red">
                                        <path
                                            d="M47.6 300.4L228.3 469.1c7.5 7 17.4 10.9 27.7 10.9s20.2-3.9 27.7-10.9L464.4 300.4c30.4-28.3 47.6-68 47.6-109.5v-5.8c0-69.9-50.5-129.5-119.4-141C347 36.5 300.6 51.4 268 84L256 96 244 84c-32.6-32.6-79-47.5-124.6-39.9C50.5 55.6 0 115.2 0 185.1v5.8c0 41.5 17.2 81.2 47.6 109.5z" />
                                    </svg>
                                </a>

                                <span class="mx-1 me-3">|</span>

                                <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://github.com/mdo.png" alt="mdo" width="32" height="32"
                                        class="rounded-circle">
                                </a>
                                <ul class="dropdown-menu text-small" style="">
                                    <li><a href="/profile" class="dropdown-item" href="#">Profile</a></li>
                                    <li><a href="#" class="dropdown-item d-flex align-items-center">Wishlist</a></li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li><a href="/logout" class="dropdown-item" href="#">Logout</a></li>
                                </ul>
                            </div>
                            {{else }}

                            <a href="/login" class="btn btn-outline-primary me-2">Login</a>
                            <a href="/registration" class="btn btn-primary me-2">Sign-up</a>
                            {{/if }}
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </header>