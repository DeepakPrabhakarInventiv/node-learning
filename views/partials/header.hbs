<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>

<body>

    <header class="border-bottom">
        <div class="container">
            <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3">
                <div class="col-md-3 mb-2 mb-md-0">
                    <a href="/" class="d-inline-flex link-body-emphasis text-decoration-none">
                        <strong class="text-uppercase">Ecommerce NodeJS</strong>
                    </a>
                </div>


                <div class="col-md-4 text-end d-flex justify-content-end align-items-center">

                    {{#if isLoggedIn}}
                    <div class="dropdown text-end">
                        <a href="#" class="d-block link-body-emphasis text-decoration-none dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://github.com/mdo.png" alt="mdo" width="32" height="32"
                                class="rounded-circle">
                        </a>
                        <ul class="dropdown-menu text-small" style="">
                            <li><a href="/profile" class="dropdown-item" href="#">Profile</a></li>
                            <li><a href="/logout" class="dropdown-item" href="#">Logout</a></li>
                        </ul>
                    </div>
                    {{else }}

                    <a href="/login" class="btn btn-outline-primary me-2">Login</a>
                    <a href="/registration" class="btn btn-primary me-2">Sign-up</a>
                    {{/if }}

                </div>
            </div>
        </div>
    </header>