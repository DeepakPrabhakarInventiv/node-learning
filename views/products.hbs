{{> header }}

<div class="bg-white">
    <div class="container py-5">

        <h3 class="border-bottom border-dark pb-2 mb-5">Products</h3>

        <!-- Begin::Products -->
        <div class="row" id="products">
            {{#each products}}
            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                <div class="card h-100">
                    <div class="bg-primary-subtle text-center px-3 py-5">
                        <div class="category text-capitalize">{{ this.category }}</div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">{{truncateWords this.name 8}}</h5>
                        <p class="card-text">{{truncateWords this.description 20}}</p>
                        <p class="card-text">Price: {{this.price}}</p>
                        <p class="card-text">Quantity: {{this.quantity}}</p>
                    </div>
                    <div class="card-footer py-3">
                        <button type="button" class="add-to-cart btn btn-outline-primary w-100 mb-3"
                            data-pid="{{ this._id }}">Add
                            to Cart</button>
                        <button type="button" class="add-to-wishlist btn btn-outline-dark w-100"
                            data-pid="{{ this._id }}">Add to
                            Wishlist</button>
                    </div>

                </div>
            </div>
            {{/each}}
        </div>
        <!-- End::Products -->

        <!-- Begin::Pagination -->
        <div class="text-center border-top pt-3 mt-3">
            {{#if prevCursor}}
            <a href="?cursor={{prevCursor}}&direction=prev" class="btn btn-outline-dark">
                Prev
            </a>
            {{/if}}

            {{#if nextCursor }}
            <a href="?cursor={{nextCursor}}&direction=next" class="btn btn-outline-dark">
                Next
            </a>
            {{/if}}
        </div>
        <!-- End::Pagination -->

    </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>


<script src="https://unpkg.com/axios@1.6.7/dist/axios.min.js"></script>
<script>
    const container = document.getElementById('products');

    //add to cart
    container.addEventListener('click', (event) => {
        if (event.target.classList.contains('add-to-cart')) {
            const pid = event.target.getAttribute('data-pid');

            const formData = {
                product_id: pid,
                count: 1,
            };

            axios.post('/cart', formData)
                .then(function (response) {
                    console.log(response);
                    createToast('Success', response.data.message, 'success');
                })
                .catch(function (error) {
                    console.error(error);
                    createToast('Error', error.response.data.message, 'danger');
                });

        }
    });

    //add to wishlist
    container.addEventListener('click', (event) => {
        if (event.target.classList.contains('add-to-wishlist')) {
            const pid = event.target.getAttribute('data-pid');

            const formData = {
                product_id: pid,
                count: 1,
            };

            axios.post('/wishlist', formData)
                .then(function (response) {
                    console.log(response);
                    createToast('Success', response.data.message, 'success');
                })
                .catch(function (error) {
                    console.error(error);
                    createToast('Error', error.response.data.message, 'danger');
                });

        }
    });


    // Function to create and show a Bootstrap toast
    function createToast(title, message, type) {
        // Generate a unique ID for the toast
        const toastId = `toast-${Date.now()}`;

        // Toast template
        const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-bg-${type} border-0" role="alert" aria-live="assertive" aria-atomic="true">
          <div class="d-flex" data-bs-theme="dark">
            <div class="toast-body" >
              <strong>${title}:</strong> ${message}
            </div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
          </div>
        </div>
      `;

        // Create a wrapper element and set its inner HTML
        const wrapper = document.createElement('div');
        wrapper.innerHTML = toastHtml.trim();

        // Append the toast to the container
        const toastContainer = document.getElementById('toast-container');
        toastContainer.appendChild(wrapper.firstChild);

        // Initialize and show the toast
        const toastElement = document.getElementById(toastId);
        const toast = new bootstrap.Toast(toastElement, { delay: 5000 }); // 5-second delay
        toast.show();

        // Remove the toast from the DOM after it hides
        toastElement.addEventListener('hidden.bs.toast', function () {
            toastElement.remove();
        });
    }

</script>

{{> footer }}